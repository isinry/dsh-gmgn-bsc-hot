{
  "name": "dsh-bsc-hot",
  "version": "0.3.2",
  "private": true,
  "description": "DSH left-sidebar BSC top-20 tracker via GMGN OpenAPI: two live boards, desktop alerts, and an in-panel settings view for the GMGN API key, Ed25519 key pair and proxy; runs on macOS, Linux and Windows.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/config-store.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "cordis",
    "bsc",
    "gmgn",
    "plugin"
  ],
  "license": "MIT"
}
