{
  "name": "dsh-bsc-hot",
  "version": "0.1.0",
  "private": true,
  "description": "Right-sidebar tab that tracks the BSC top-20 tokens by 5-minute trading volume via GMGN OpenAPI, refreshing once per second; click a token to open gmgn.ai.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "cordis",
    "bsc",
    "gmgn",
    "plugin"
  ],
  "license": "MIT"
}
